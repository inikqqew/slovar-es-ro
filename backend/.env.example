PORT=4000

# База: для `npm run local` задаётся автоматически (встроенный Postgres).
# Для Render/Neon — строка подключения вида postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# ===== AI (чат-бот + разбор слов). Достаточно ОДНОГО бесплатного ключа =====
# Вариант 1 (рекомендуется): Groq — бесплатно, без карты. Ключ: https://console.groq.com/keys
#   LLM_API_KEY=gsk_...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b   (модели в вашем аккаунте: curl -H "Authorization: Bearer КЛЮЧ" https://api.groq.com/openai/v1/models)
# Вариант 2: Google Gemini — бесплатно. Ключ: https://aistudio.google.com/apikey
#   LLM_API_KEY=AIza...
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.0-flash
# Вариант 3: любой другой OpenAI-совместимый сервис (OpenRouter, Mistral…) — те же три переменные.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# (необязательно) Claude вместо LLM_*: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Перевод — MyMemory без ключа (~5000 симв./день). Email поднимает лимит до 50000.
MYMEMORY_EMAIL=
