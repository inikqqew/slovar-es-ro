PORT=4000

# Postgres — бесплатный тир Neon (neon.tech). Скопировать "Connection string"
# из дашборда проекта. Используется и локально, и в проде (приложение и так
# требует интернет).
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/dbname?sslmode=require"

# LLM — верификация слов + чат-бот практики (console.anthropic.com)
ANTHROPIC_API_KEY=

# Перевод — MyMemory Translation API, без ключа (лимит ~5000 симв./день с IP).
# Необязательный email поднимает лимит до 50000 симв./день — см. https://mymemory.translated.net
MYMEMORY_EMAIL=
