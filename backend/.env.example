PORT=4000

# Локально — SQLite (файл создаётся автоматически при первой миграции).
# Для прод-деплоя — Postgres на Supabase/Neon: postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# LLM — верификация слов + чат-бот практики (console.anthropic.com)
ANTHROPIC_API_KEY=

# Перевод — MyMemory Translation API, без ключа (лимит ~5000 симв./день с IP).
# Необязательный email поднимает лимит до 50000 симв./день — см. https://mymemory.translated.net
MYMEMORY_EMAIL=
