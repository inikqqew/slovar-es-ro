generator client {
  provider = "prisma-client-js"
}

// Postgres (Neon, бесплатный тир) — и локально, и в проде используется одна
// и та же облачная база через DATABASE_URL, т.к. приложение и так требует
// интернет (см. ТЗ 4.4/5.3). language/status/quizType хранятся как String,
// а не нативные enum — Postgres это прекрасно поддерживает, но так схема
// осталась идентичной прежней SQLite-версии без отдельной миграции полей.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Допустимые значения (String вместо enum — см. комментарий выше):
// Language: "es" | "ro"
// VerificationStatus: "unverified" | "ai_verified" | "source_verified"
// QuizType: "fill_blank" | "multiple_choice" | "flashcard" | "matching" | "spelling"

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  isAnonymous Boolean  @default(true)
  themePref   String   @default("light")
  createdAt   DateTime @default(now())

  words        Word[]
  savedWords   SavedWord[]
  quizProgress QuizProgress[]
  chatSessions ChatSession[]
}

model Word {
  id           String   @id @default(cuid())
  text         String
  language     String
  translation  String
  meaning      String
  partOfSpeech String?
  gender       String?
  examples     Json     @default("[]")
  status       String   @default("unverified")
  source       String?
  isCustom     Boolean  @default(false)
  createdAt    DateTime @default(now())

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  quizProgress QuizProgress[]
  savedBy      SavedWord[]

  @@index([text, language])
  @@index([ownerId])
}

// Слово из общего кэша (Этап 2), которое пользователь сохранил в свой словарь
// без изменения самой записи — CRUD доступен только для isCustom-слов.
model SavedWord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId])
}

model QuizProgress {
  id           String   @id @default(cuid())
  quizType     String
  attempts     Int      @default(0)
  successRate  Float    @default(0)
  nextReviewAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId, quizType])
}

model ChatSession {
  id        String   @id @default(cuid())
  language  String
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
